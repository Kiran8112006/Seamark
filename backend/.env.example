# SEAMARK Backend Environment Configuration
# Copy this file to .env for local deployment

# Server Binding
SEAMARK_HOST=127.0.0.1
SEAMARK_PORT=8000

# Cryptographic Authentication Key (use a secure random string for production)
SEAMARK_HMAC_SECRET=replace_with_a_secure_random_secret

# CORS Allowed Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
